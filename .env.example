# 复制为 .env 后填写自己的配置。不要把填写后的 .env 发到群里或提交到仓库。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.gpt.ge/v1
OPENAI_MODEL=gpt-4o-mini

# 表格模块目录（未设置时使用以下默认值）
# TABULAR_DATASET_DIR=tabular_data/datasets
# TABULAR_UPLOAD_DIR=tabular_data/uploads
# TABULAR_OUTPUT_DIR=tabular_data/outputs

# Math 完整扩充流程配置
MATH_MAX_MASK_ROUNDS=10
MATH_MAX_REFINE_ROUNDS=3
MATH_PATIENCE=2
MATH_ACCEPT_THRESHOLD=0.80

# 真实接口失败时自动使用 mock，保证演示不中断
USE_MOCK_WHEN_LLM_FAILS=1
